@@ -178,7 +178,10 @@
 def nanoRustHostTag = { ndkDir ->
-    def armTag = file("${ndkDir}/toolchains/llvm/prebuilt/darwin-arm64")
-    if (armTag.exists()) {
-        return "darwin-arm64"
-    }
-    return "darwin-x86_64"
+    def hostTags = ["linux-x86_64", "darwin-arm64", "darwin-x86_64"]
+    def hostTag = hostTags.find { tag ->
+        file("${ndkDir}/toolchains/llvm/prebuilt/${tag}").exists()
+    }
+    if (hostTag == null) {
+        throw new GradleException("No supported Android NDK host toolchain found")
+    }
+    return hostTag
 }
